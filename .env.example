# Глобальные переменные — скопируй в .env и заполни

# ── Anthropic API (настоящий ключ — ТОЛЬКО здесь, инстансы его не видят) ─
ANTHROPIC_API_KEY=sk-ant-...

# ── Quota Proxy ──────────────────────────────────────────────────────────
QUOTA_ADMIN_TOKEN=   # сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
QUOTA_DEFAULT_MONTHLY=1000000  # 1M токенов/мес по умолчанию (0 = без лимита)

# Квота-ключи инстансов (генерируются автоматически при make add-user):
QUOTA_KEY_ADMIN=     # admin ходит напрямую, этот ключ не используется
# QUOTA_KEY_NIKITA=quota-nikita-...
# QUOTA_KEY_ALEXEY=quota-alexey-...

# Лимиты инстансов (токенов/мес, добавляются при make add-user или make set-limit):
# QUOTA_LIMIT_NIKITA=1000000
# QUOTA_LIMIT_ALEXEY=500000

# ── Message Broker ───────────────────────────────────────────────────────
BROKER_KEY_ADMIN=    # сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# BROKER_KEY_NIKITA= (добавляется при make add-user)
# BROKER_KEY_ALEXEY=

# ── Resource Monitor ─────────────────────────────────────────────────────
MONITOR_ADMIN_TOKEN=   # сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ALERT_CPU_PCT=80
ALERT_RAM_PCT=85
ALERT_DISK_PCT=90
ALERT_QUOTA_PCT=80

# ── Service Agent ─────────────────────────────────────────────────────────
SERVICE_API_KEY=       # сгенерируй: python3 -c "import secrets; print('svc-' + secrets.token_urlsafe(24))"
DADATA_API_KEY=cc9c112a3cf837959f3ec5a0a4c602fec0f3ded9
DADATA_SECRET=f0e4407f081edf94b4f761ed0a6040630c7ba42c
# Путь к реальному enrich.py на хосте; если не задан — используется placeholder
