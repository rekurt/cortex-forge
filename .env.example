# Глобальные переменные — скопируй в .env и заполни

# ── Anthropic API (один ключ на всех) ────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Message Broker API-ключи ─────────────────────────
# Генерируются автоматически при make add-user
# Формат: BROKER_KEY_<NAME_UPPER>=<random_secret>
BROKER_KEY_ADMIN=   # сгенерируй: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
BROKER_KEY_NIKITA=  # добавляется автоматически при make add-user NAME=nikita
# BROKER_KEY_ALEXEY=
# BROKER_KEY_DMITRY=

# ── Опционально: общий GitLab токен (read-only) ──────
# GITLAB_TOKEN=glpat-...
# GITLAB_URL=https://your-gitlab.example.com
