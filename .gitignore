.idea
# Пользовательские инстансы — генерируются локально, не конфликтуют с git pull
docker-compose.override.yml

# Секреты — никогда в git
.env
.anthropic_tokens.json
.cli-proxy-api/
Codex-*.json
instances/*/.env
instances/*/openclaw.json
!instances/admin/openclaw.json
instances/*/openclaw_data/
**/*.env
**/*.key
**/*.token
**/*.db
**/*.sqlite

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
logs/*.log

# Личная память — опционально исключить
# instances/*/workspace/memory/
# instances/*/workspace/MEMORY.md

# Compliance данные
**/data/cache/
**/data/snapshots/
**/data/fns.db
**/data/watchlist.json

# Архивы
backups/

# OS
.DS_Store
Thumbs.db

# ralphex progress logs
.ralphex/progress/
/docs/plans/*

# Greeting counter state
shared/skills/corp-greeting/.greeting_counter

# Migration state per instance (local)
instances/*/.migrations_applied
instances/*/openclaw_data/.migrations_applied

# Instance workspace runtime data (not tracked)
instances/*/workspace/memory/
instances/*/workspace/MEMORY.md
instances/*/workspace/.openclaw/
instances/*/workspace/.git/
instances/*/workspace/.gitignore
instances/*/workspace/notes-vault/
instances/*/workspace/BOOTSTRAP.md
instances/*/workspace/node_modules
*.lock
