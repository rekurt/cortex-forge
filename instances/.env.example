# Шаблон .env для инстанса (admin или сотрудника)
# Скопируй в instances/<name>/.env и заполни реальными значениями.
# ⚠️  Этот файл НЕ должен содержать реальных секретов — только примеры.

# Telegram-бот инстанса (получить через @BotFather)
TELEGRAM_BOT_TOKEN=change-me-bot-token

# Telegram ID(s) которым разрешён доступ (через запятую)
TELEGRAM_ALLOW_FROM=change-me-telegram-id

# Broker — внутренняя шина (URL не менять, ключ генерируется через add-user.sh)
BROKER_URL=http://message-broker:8080
BROKER_KEY=change-me-broker-key

# (Опционально) Яндекс OAuth для Трекера/Календаря/Почты
# YANDEX_OAUTH_TOKEN=
# YANDEX_CALDAV_URL=
# YANDEX_USER=
# YANDEX_APP_PASSWORD=
