FROM ghcr.io/openclaw/openclaw:latest

# ffmpeg — для транскрипции голосовых (openai-whisper-api)
# mcporter — MCP CLI для вызова внешних инструментов (DaData и др.)
USER root
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    apt-get clean && rm -rf /var/lib/apt/lists/* && \
    npm install -g mcporter
USER node
