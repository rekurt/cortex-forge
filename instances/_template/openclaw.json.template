{
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-sonnet-4-6"
      },
      "workspace": "/home/node/.openclaw/workspace",
      "compaction": {
        "mode": "safeguard"
      }
    }
  },
  "models": {
    "providers": {
      "anthropic": {
        "baseUrl": "http://quota-proxy:9090",
        "api": "anthropic-messages",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "models": [
          {
            "id": "claude-sonnet-4-6",
            "name": "Claude Sonnet 4.6",
            "api": "anthropic-messages",
            "contextWindow": 200000,
            "maxTokens": 16000
          }
        ]
      },
      "openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "whisper-1",
            "name": "Whisper"
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "botToken": "{{BOT_TOKEN}}",
      "allowFrom": [
        0,
        0
      ],
      "dmPolicy": "pairing",
      "streaming": "off",
      "actions": {
        "reactions": true,
        "sendMessage": true,
        "deleteMessage": false
      },
      "reactionLevel": "minimal"
    }
  },
  "gateway": {
    "mode": "local",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "${GATEWAY_TOKEN}"
    }
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto"
  },
  "mcpServers": {
    "dadata": {
      "command": "npx",
      "args": [
        "-y",
        "supergateway",
        "--streamableHttp",
        "https://mcp.dadata.ru/mcp",
        "--oauth2Bearer",
        ":"
      ]
    },
    "context-mode": {
      "command": "npx",
      "args": [
        "-y",
        "context-mode"
      ]
    }
  },
  "tools": {
    "media": {
      "audio": {
        "enabled": true,
        "models": [
          {
            "provider": "openai",
            "model": "whisper-1",
            "capabilities": [
              "audio"
            ],
            "type": "provider"
          }
        ]
      }
    }
  }
}